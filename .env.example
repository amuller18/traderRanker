# AWS Credentials (Server-side only - NEVER expose these to the browser)
# Get these from your AWS IAM console
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Optional AWS Session Token (if you're using temporary credentials)
AWS_SESSION_TOKEN=

# DynamoDB Table Names
# DYNAMODB_TRADES_TABLE: Table containing trade records (used by pi-backend)
DYNAMODB_TRADES_TABLE=Trades
# DYNAMODB_TRADERS_TABLE: Table containing trader statistics (used by pi-backend, default: CallerStatistics)
DYNAMODB_TRADERS_TABLE=CallerStatistics
# DYNAMODB_TRADER_STATISTICS: Alternative name for trader statistics table (used by some Next.js components)
DYNAMODB_TRADER_STATISTICS=CallerStatistics

# API URL for client-side use
NEXT_PUBLIC_PYTHON_API_URL=http://localhost:8000

# Birdeye API Keys (Comma separated)
# Get these from https://birdeye.so
BIRDEYE_API_KEY=your_api_key_here

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # IMPORTANT: Server-side only! Never expose to frontend

# Phantom Wallet Authentication (Optional)
NEXT_PUBLIC_API_URL=http://localhost:8000  # For frontend API calls
JWT_SECRET=your-secret-key-change-in-production  # Optional: for custom JWT implementation

# Vercel Frontend Environment Variables

# Raspberry Pi API Configuration
# This should be your Cloudflare Tunnel URL
NEXT_PUBLIC_PI_API_BASE=https://api.yourdomain.com

# API Key for authenticating with your Pi backend
# Must match the API_KEY in your Pi's .env file
NEXT_PUBLIC_PI_API_KEY=your-secure-random-api-key-min-32-characters

# Supabase Configuration (if you're using Supabase for auth)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: For local development, point to localhost
# NEXT_PUBLIC_PI_API_BASE=http://localhost:4000

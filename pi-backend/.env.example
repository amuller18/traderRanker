# Server Configuration
PORT=8000
NODE_ENV=production

# API Security
API_KEY=your-secure-api-key-here-use-a-long-random-string
ALLOWED_ORIGINS=https://your-vercel-app.vercel.app

# AWS DynamoDB Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
DYNAMODB_TRADERS_TABLE=CallerStatistics
DYNAMODB_TRADES_TABLE=Trades
# DYNAMODB_TRADER_STATISTICS: Official pre-computed trader statistics table (uses 'username' as primary key)
DYNAMODB_TRADER_STATISTICS=officialStats

# Optional: Cloudflare Access (if using Cloudflare Tunnel with Access)
# CLOUDFLARE_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CLOUDFLARE_AUD=your-application-audience-tag

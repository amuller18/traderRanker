[Unit]
Description=Trader Ranker FastAPI Backend
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/traderRanker
Environment="PATH=/home/pi/traderRanker/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/pi/traderRanker/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10

# Logging
StandardOutput=append:/var/log/trader-ranker-backend.log
StandardError=append:/var/log/trader-ranker-backend-error.log

[Install]
WantedBy=multi-user.target
